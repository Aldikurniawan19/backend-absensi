# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai variabel berikut.

# 1. Server Configuration
PORT=3000
NODE_ENV=production
# URL frontend web (misal di Vercel: https://absensi-sekolah.vercel.app)
CORS_ORIGIN="http://localhost:3001,https://your-frontend.vercel.app"

# 2. Database Connection (Supabase PostgreSQL / Local)
# FORMAT SUPABASE:
# DATABASE_URL (Transaction Pooler - Port 6543):
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistem_absensi?schema=public"

# DIRECT_URL (Direct Connection - Port 5432 untuk Prisma migrate/db push):
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sistem_absensi?schema=public"

# 3. JWT Authentication Security
# Ganti dengan secret acak panjang (misal 64 karakter)
JWT_SECRET="replace-with-super-secure-random-jwt-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-super-secure-random-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="30d"

# 4. QR Token Secret
QR_SECRET="replace-with-super-secure-qr-token-key"

# 5. Rate Limiting & Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# 6. File Upload Storage
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE=5242880 # 5MB dalam bytes
