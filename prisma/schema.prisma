datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

enum UserRole {
  SISWA
  GURU
  ADMIN
}

enum TahunAjaranStatus {
  DRAFT
  AKTIF
  NONAKTIF
}

enum SesiAbsensiStatus {
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

enum AbsensiStatus {
  HADIR
  TERLAMBAT
  ALPA
  IZIN
  SAKIT
}

enum AbsensiSumber {
  SCAN_QR
  MANUAL
}

enum IzinJenis {
  IZIN
  SAKIT
}

enum IzinStatus {
  PENDING
  DISETUJUI
  DITOLAK
}

enum SesiLoginStatus {
  AKTIF
  LOGOUT
  EXPIRED
}

enum KomponenNilai {
  FORMATIF
  STS
  SAS
}

enum StatusRaport {
  DRAFT
  FINAL
}

model Sekolah {
  id                    String            @id @default(uuid())
  nama                  String
  npsn                  String            @unique
  alamat                String?
  wajib_gps             Boolean           @default(false)
  lat_sekolah           Decimal?          @db.Decimal(10, 7)
  lng_sekolah           Decimal?          @db.Decimal(10, 7)
  radius_meter          Int               @default(100)
  maks_sesi_aktif_siswa Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tahun_ajaran          TahunAjaran[]
  jurusan               Jurusan[]
  kelas                 Kelas[]
  siswa                 Siswa[]
  guru                  Guru[]
  admin                 Admin[]
  mata_pelajaran        MataPelajaran[]
  audit_logs            AuditLog[]
  konfigurasi_penilaian KonfigurasiPenilaian[]
  ekstrakurikuler       Ekstrakurikuler[]

  @@map("sekolah")
}

model TahunAjaran {
  id                    String                 @id @default(uuid())
  sekolah_id            String
  nama                  String                 // e.g. "2024/2025"
  semester              String                 // e.g. "Ganjil", "Genap"
  tanggal_mulai         DateTime               @db.Date
  tanggal_selesai       DateTime               @db.Date
  status                TahunAjaranStatus      @default(DRAFT)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  sekolah               Sekolah                @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  jadwal_pelajaran      JadwalPelajaran[]
  riwayat_kelas_siswa   RiwayatKelasSiswa[]
  penugasan_wali_kelas  PenugasanWaliKelas[]
  konfigurasi_penilaian KonfigurasiPenilaian[]
  nilai_siswa           NilaiSiswa[]
  ekstrakurikuler_siswa EkstrakurikulerSiswa[]
  raport                Raport[]
  catatan_capaian       CatatanCapaian[]

  @@index([sekolah_id, status])
  @@map("tahun_ajaran")
}

model Jurusan {
  id          String    @id @default(uuid())
  sekolah_id  String
  nama        String    // e.g. "MIPA", "IPS", "Bahasa"
  kode        String    // e.g. "MIPA"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sekolah     Sekolah   @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  kelas       Kelas[]

  @@unique([sekolah_id, kode])
  @@map("jurusan")
}

model Kelas {
  id                    String                 @id @default(uuid())
  sekolah_id            String
  jurusan_id            String
  tingkat               Int                    // 10, 11, 12
  nama_rombel           String                 // "1", "2" -> "10 MIPA 1"
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  sekolah               Sekolah                @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  jurusan               Jurusan                @relation(fields: [jurusan_id], references: [id], onDelete: Restrict)
  jadwal_pelajaran      JadwalPelajaran[]
  riwayat_kelas_siswa   RiwayatKelasSiswa[]
  penugasan_wali_kelas  PenugasanWaliKelas[]
  nilai_siswa           NilaiSiswa[]
  raport                Raport[]

  @@unique([sekolah_id, tingkat, jurusan_id, nama_rombel])
  @@index([sekolah_id, tingkat])
  @@map("kelas")
}

model Siswa {
  id                    String                 @id @default(uuid())
  sekolah_id            String
  nama                  String
  nisn                  String                 @unique
  email                 String                 @unique
  password              String
  no_hp_ortu           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  sekolah               Sekolah                @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  riwayat_kelas         RiwayatKelasSiswa[]
  sesi_login            SesiLogin[]
  absensi               Absensi[]
  pengajuan_izin        PengajuanIzin[]
  nilai_siswa           NilaiSiswa[]
  ekstrakurikuler_siswa EkstrakurikulerSiswa[]
  raport                Raport[]
  catatan_capaian       CatatanCapaian[]

  @@index([sekolah_id, nisn])
  @@map("siswa")
}

model RiwayatKelasSiswa {
  id               String       @id @default(uuid())
  siswa_id         String
  kelas_id         String
  tahun_ajaran_id  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  siswa            Siswa        @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  kelas            Kelas        @relation(fields: [kelas_id], references: [id], onDelete: Restrict)
  tahun_ajaran     TahunAjaran  @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  @@unique([siswa_id, tahun_ajaran_id])
  @@index([kelas_id, tahun_ajaran_id])
  @@map("riwayat_kelas_siswa")
}

model Guru {
  id                    String                @id @default(uuid())
  sekolah_id            String
  nama                  String
  nip                   String                @unique
  email                 String                @unique
  password              String
  no_hp                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  sekolah               Sekolah               @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  sesi_login            SesiLogin[]
  jadwal_pelajaran      JadwalPelajaran[]
  guru_mapel            GuruMapel[]
  penugasan_wali_kelas  PenugasanWaliKelas[]
  nilai_siswa           NilaiSiswa[]
  raport_sebagai_wali   Raport[]              @relation("RaportWaliKelas")
  catatan_capaian       CatatanCapaian[]

  @@index([sekolah_id, nip])
  @@map("guru")
}

model Admin {
  id          String       @id @default(uuid())
  sekolah_id  String
  nama        String
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sekolah     Sekolah      @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  sesi_login  SesiLogin[]

  @@index([sekolah_id, email])
  @@map("admin")
}

model PenugasanWaliKelas {
  id               String       @id @default(uuid())
  guru_id          String
  kelas_id         String
  tahun_ajaran_id  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  guru             Guru         @relation(fields: [guru_id], references: [id], onDelete: Cascade)
  kelas            Kelas        @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran  @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  @@unique([kelas_id, tahun_ajaran_id])
  @@index([guru_id, tahun_ajaran_id])
  @@map("penugasan_wali_kelas")
}

model MataPelajaran {
  id                String            @id @default(uuid())
  sekolah_id        String
  nama              String
  kode              String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sekolah           Sekolah           @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  jadwal_pelajaran  JadwalPelajaran[]
  guru_mapel        GuruMapel[]
  nilai_siswa       NilaiSiswa[]
  catatan_capaian   CatatanCapaian[]

  @@unique([sekolah_id, kode])
  @@map("mata_pelajaran")
}

model GuruMapel {
  id          String        @id @default(uuid())
  guru_id     String
  mapel_id    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  guru        Guru          @relation(fields: [guru_id], references: [id], onDelete: Cascade)
  mapel       MataPelajaran @relation(fields: [mapel_id], references: [id], onDelete: Cascade)

  @@unique([guru_id, mapel_id])
  @@map("guru_mapel")
}

model JadwalPelajaran {
  id               String          @id @default(uuid())
  kelas_id         String
  guru_id          String
  mapel_id         String
  tahun_ajaran_id  String
  hari             Int             // 1 = Senin, 2 = Selasa, 3 = Rabu, 4 = Kamis, 5 = Jumat, 6 = Sabtu, 7 = Minggu
  jam_mulai        String          // Format: "HH:mm" misal "07:30"
  jam_selesai      String          // Format: "HH:mm" misal "09:00"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  kelas            Kelas           @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  guru             Guru            @relation(fields: [guru_id], references: [id], onDelete: Cascade)
  mapel            MataPelajaran   @relation(fields: [mapel_id], references: [id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran     @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)
  sesi_absensi     SesiAbsensi[]

  @@index([guru_id, hari])
  @@index([kelas_id, hari])
  @@index([tahun_ajaran_id])
  @@index([kelas_id, tahun_ajaran_id])
  @@index([guru_id, tahun_ajaran_id])
  @@map("jadwal_pelajaran")
}

model SesiLogin {
  id                    String          @id @default(uuid())
  siswa_id              String?
  guru_id               String?
  admin_id              String?
  device_info           String
  token_refresh         String          // Hashed refresh token
  waktu_login           DateTime        @default(now())
  waktu_terakhir_aktif  DateTime        @default(now())
  status                SesiLoginStatus @default(AKTIF)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  siswa                 Siswa?          @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  guru                  Guru?           @relation(fields: [guru_id], references: [id], onDelete: Cascade)
  admin                 Admin?          @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([siswa_id, status])
  @@index([guru_id, status])
  @@index([admin_id, status])
  @@map("sesi_login")
}

model SesiAbsensi {
  id           String            @id @default(uuid())
  jadwal_id    String
  token_qr     String            @unique
  waktu_mulai  DateTime          @default(now())
  waktu_exp    DateTime
  status       SesiAbsensiStatus @default(BERLANGSUNG)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  jadwal       JadwalPelajaran   @relation(fields: [jadwal_id], references: [id], onDelete: Cascade)
  absensi      Absensi[]

  @@index([jadwal_id, status])
  @@index([createdAt])
  @@index([jadwal_id, createdAt])
  @@map("sesi_absensi")
}

model Absensi {
  id          String        @id @default(uuid())
  sesi_id     String
  siswa_id    String
  waktu_scan  DateTime?
  status      AbsensiStatus
  lokasi_lat  Decimal?      @db.Decimal(10, 7)
  lokasi_lng  Decimal?      @db.Decimal(10, 7)
  sumber      AbsensiSumber @default(SCAN_QR)
  keterangan  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sesi        SesiAbsensi   @relation(fields: [sesi_id], references: [id], onDelete: Cascade)
  siswa       Siswa         @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@unique([sesi_id, siswa_id])
  @@index([siswa_id, status])
  @@index([sesi_id, status])
  @@index([siswa_id, createdAt])
  @@index([sesi_id])
  @@map("absensi")
}

model PengajuanIzin {
  id                 String     @id @default(uuid())
  siswa_id           String
  tanggal            DateTime   @db.Date
  jenis              IzinJenis
  keterangan         String
  file_bukti         String?
  status_approval    IzinStatus @default(PENDING)
  disetujui_oleh_id  String?
  alasan_penolakan   String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  siswa              Siswa      @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@index([siswa_id, tanggal])
  @@index([status_approval, tanggal])
  @@map("pengajuan_izin")
}

model AuditLog {
  id          String    @id @default(uuid())
  sekolah_id  String
  actor_id    String
  actor_type  UserRole
  action      String
  resource    String
  resource_id String?
  details     String?   @db.Text
  ip_address  String?
  createdAt   DateTime  @default(now())

  sekolah     Sekolah   @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)

  @@index([sekolah_id, actor_id])
  @@map("audit_log")
}

model KonfigurasiPenilaian {
  id               String       @id @default(uuid())
  sekolah_id       String
  tahun_ajaran_id  String
  bobot_formatif   Int          @default(40) // Persen
  bobot_sts        Int          @default(30)
  bobot_sas        Int          @default(30)
  batas_bb         Int          @default(40) // 0 - batas_bb (BB)
  batas_mb         Int          @default(65) // batas_bb+1 - batas_mb (MB)
  batas_bsh        Int          @default(85) // batas_mb+1 - batas_bsh (BSH), di atas itu SB
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sekolah          Sekolah      @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran  @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  @@unique([sekolah_id, tahun_ajaran_id])
  @@map("konfigurasi_penilaian")
}

model NilaiSiswa {
  id               String         @id @default(uuid())
  siswa_id         String
  mapel_id         String
  kelas_id         String
  tahun_ajaran_id  String
  guru_id          String         // Guru yang menginput
  komponen         KomponenNilai
  judul            String         // e.g. "Tugas 1", "Ulangan Harian 2", "STS", "SAS"
  nilai            Decimal        @db.Decimal(5, 2) // 0.00 - 100.00
  catatan          String?        // Opsional: catatan per nilai
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  siswa            Siswa          @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  mapel            MataPelajaran  @relation(fields: [mapel_id], references: [id], onDelete: Cascade)
  kelas            Kelas          @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran    @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)
  guru             Guru           @relation(fields: [guru_id], references: [id], onDelete: Cascade)

  @@index([siswa_id, mapel_id, tahun_ajaran_id])
  @@index([kelas_id, mapel_id, tahun_ajaran_id])
  @@index([guru_id])
  @@index([kelas_id, tahun_ajaran_id])
  @@index([siswa_id, tahun_ajaran_id])
  @@map("nilai_siswa")
}

model Ekstrakurikuler {
  id          String                 @id @default(uuid())
  sekolah_id  String
  nama        String                 // e.g. "Pramuka", "Basket", "PMR"
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  sekolah     Sekolah                @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  keanggotaan EkstrakurikulerSiswa[]

  @@unique([sekolah_id, nama])
  @@map("ekstrakurikuler")
}

model EkstrakurikulerSiswa {
  id                  String            @id @default(uuid())
  siswa_id            String
  ekstrakurikuler_id  String
  tahun_ajaran_id     String
  predikat            String?           // e.g. "Sangat Baik", "Baik", "Cukup"
  keterangan          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  siswa               Siswa             @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  ekstrakurikuler     Ekstrakurikuler   @relation(fields: [ekstrakurikuler_id], references: [id], onDelete: Cascade)
  tahun_ajaran        TahunAjaran       @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  @@unique([siswa_id, ekstrakurikuler_id, tahun_ajaran_id])
  @@index([tahun_ajaran_id])
  @@index([siswa_id, tahun_ajaran_id])
  @@map("ekstrakurikuler_siswa")
}

model Raport {
  id                    String       @id @default(uuid())
  siswa_id              String
  kelas_id              String
  tahun_ajaran_id       String
  wali_kelas_id         String       // Guru yang menerbitkan raport
  catatan_wali_kelas    String?      // Narasi dari wali kelas
  status                StatusRaport @default(DRAFT)
  tanggal_terbit        DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  siswa                 Siswa        @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  kelas                 Kelas        @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  tahun_ajaran          TahunAjaran  @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)
  wali_kelas            Guru         @relation("RaportWaliKelas", fields: [wali_kelas_id], references: [id], onDelete: Cascade)

  @@unique([siswa_id, tahun_ajaran_id])
  @@index([kelas_id, tahun_ajaran_id])
  @@map("raport")
}

model CatatanCapaian {
  id               String        @id @default(uuid())
  siswa_id         String
  mapel_id         String
  tahun_ajaran_id  String
  guru_id          String
  deskripsi        String        @db.Text // Narasi capaian kompetensi
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  siswa            Siswa         @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  mapel            MataPelajaran @relation(fields: [mapel_id], references: [id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran   @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)
  guru             Guru          @relation(fields: [guru_id], references: [id], onDelete: Cascade)

  @@unique([siswa_id, mapel_id, tahun_ajaran_id])
  @@index([mapel_id, tahun_ajaran_id])
  @@index([siswa_id, tahun_ajaran_id])
  @@map("catatan_capaian")
}


model JadwalUjian {
  id               String            @id
  sekolah_id       String
  tahun_ajaran_id  String
  nama_ujian       String
  jenis            String            @default("PTS")
  tanggal_mulai    DateTime          @db.Date
  tanggal_selesai  DateTime          @db.Date
  is_active        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  items            JadwalUjianItem[]
  kartu_ujian      KartuUjian[]

  @@index([sekolah_id, is_active])
  @@map("jadwal_ujian")
}

model JadwalUjianItem {
  id               String       @id
  jadwal_ujian_id  String
  kelas_id         String
  mapel_id         String
  guru_id          String?
  tanggal          DateTime     @db.Date
  hari             Int
  jam_mulai        String
  jam_selesai      String
  ruangan          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  jadwal_ujian     JadwalUjian  @relation(fields: [jadwal_ujian_id], references: [id], onDelete: Cascade)

  @@index([jadwal_ujian_id])
  @@index([kelas_id, tanggal])
  @@index([guru_id, tanggal])
  @@map("jadwal_ujian_item")
}

model KartuUjian {
  id               String       @id
  jadwal_ujian_id  String
  siswa_id         String
  kelas_id         String
  ruangan          String
  nomor_kursi      String
  nomor_peserta    String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  jadwal_ujian     JadwalUjian  @relation(fields: [jadwal_ujian_id], references: [id], onDelete: Cascade)

  @@unique([jadwal_ujian_id, siswa_id])
  @@index([jadwal_ujian_id])
  @@index([siswa_id])
  @@index([jadwal_ujian_id, ruangan])
  @@index([jadwal_ujian_id, kelas_id])
  @@map("kartu_ujian")
}

